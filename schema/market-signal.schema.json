{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/prism-roadmap/schema/market-signal.schema.json",
  "$ref": "#/$defs/MarketSignal",
  "$defs": {
    "MarketSignal": {
      "properties": {
        "total_votes": {
          "type": "integer"
        },
        "customer_count": {
          "type": "integer"
        },
        "total_arr": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "idea_count": {
          "type": "integer"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "customer_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Market Signal",
  "description": "Schema for aggregated customer demand signals"
}