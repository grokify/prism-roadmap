{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/prism-roadmap/schema/assumption-map.schema.json",
  "$ref": "#/$defs/AssumptionMap",
  "$defs": {
    "AssumptionMap": {
      "properties": {
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "solutionRef": {
          "type": "string"
        },
        "desirability": {
          "items": {
            "$ref": "#/$defs/CDAssumption"
          },
          "type": "array"
        },
        "viability": {
          "items": {
            "$ref": "#/$defs/CDAssumption"
          },
          "type": "array"
        },
        "feasibility": {
          "items": {
            "$ref": "#/$defs/CDAssumption"
          },
          "type": "array"
        },
        "usability": {
          "items": {
            "$ref": "#/$defs/CDAssumption"
          },
          "type": "array"
        },
        "ethical": {
          "items": {
            "$ref": "#/$defs/CDAssumption"
          },
          "type": "array"
        },
        "testOrder": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prdRef": {
          "$ref": "#/$defs/PRDReference"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CDAssumption": {
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "importance": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "counterEvidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "validated": {
          "type": "boolean"
        },
        "validationDate": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Metadata": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "authors": {
          "items": {
            "$ref": "#/$defs/Person"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prdRef": {
          "type": "string"
        },
        "featureRef": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PRDReference": {
      "properties": {
        "prdId": {
          "type": "string"
        },
        "featureIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requirementIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "userStoryIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "personaIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Person": {
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Assumption Map",
  "description": "Schema for Assumption Map (DVFUE matrix) from Continuous Discovery"
}