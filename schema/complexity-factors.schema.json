{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/prism-roadmap/schema/complexity-factors.schema.json",
  "$ref": "#/$defs/ComplexityFactors",
  "$defs": {
    "ComplexityFactors": {
      "properties": {
        "new_architecture": {
          "type": "boolean"
        },
        "new_design_ux": {
          "type": "boolean"
        },
        "new_billing_sku": {
          "type": "boolean"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "type": "array"
        },
        "new_integration": {
          "type": "boolean"
        },
        "new_compliance": {
          "type": "boolean"
        },
        "new_data_model": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Dependency": {
      "properties": {
        "team_id": {
          "type": "string"
        },
        "team_name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "estimated_days": {
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Complexity Factors",
  "description": "Schema for implementation complexity tracking"
}