        "testRefs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DTTest": {
      "properties": {
        "id": {
          "type": "string"
        },
        "prototypeRef": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "participants": {
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "positiveFeedback": {
          "items": {
            "type": "string"
