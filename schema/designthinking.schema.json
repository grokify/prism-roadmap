        "goal": {
          "type": "string"
        },
        "says": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thinks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "does": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "feels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sees": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hears": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "personaRef": {
          "type": "string"
        }
