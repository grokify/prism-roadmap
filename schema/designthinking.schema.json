        "quoteRefs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DTInterview": {
      "properties": {
        "id": {
          "type": "string"
        },
        "participantType": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "keyQuotes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "insights": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "empathyMapRef": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DTObservation": {
      "properties": {
        "id": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "behaviors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "surprises": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DTPrototype": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "fidelity": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ideaRefs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "iteration": {
          "type": "integer"
        },
        "status": {
