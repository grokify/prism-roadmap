        "shouldContinue": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DTUserNeed": {
      "properties": {
        "id": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "need": {
          "type": "string"
        },
        "insight": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "validated": {
          "type": "boolean"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DesignThinkingCanvas": {
      "properties": {
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "empathyMaps": {
          "items": {
            "$ref": "#/$defs/EmpathyMap"
          },
          "type": "array"
        },
        "interviews": {
          "items": {
            "$ref": "#/$defs/DTInterview"
          },
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/DTObservation"
          },
          "type": "array"
        },
        "problemStatement": {
          "type": "string"
        },
        "userNeeds": {
          "items": {
            "$ref": "#/$defs/DTUserNeed"
          },
          "type": "array"
        },
        "insights": {
          "items": {
            "$ref": "#/$defs/DTInsight"
          },
          "type": "array"
        },
        "howMightWe": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ideationSessions": {
          "items": {
            "$ref": "#/$defs/IdeationSession"
          },
          "type": "array"
        },
        "ideas": {
          "items": {
            "$ref": "#/$defs/DTIdea"
          },
          "type": "array"
        },
        "selectedIdeas": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prototypes": {
          "items": {
            "$ref": "#/$defs/DTPrototype"
          },
          "type": "array"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/DTTest"
          },
          "type": "array"
        },
        "iterationCount": {
          "type": "integer"
        },
        "currentPhase": {
          "type": "string"
        },
        "prdRef": {
          "$ref": "#/$defs/PRDReference"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EmpathyMap": {
      "properties": {
        "id": {
          "type": "string"
        },
        "personaName": {
          "type": "string"
