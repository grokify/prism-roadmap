        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "sessionRef": {
          "type": "string"
        },
        "votes": {
          "type": "integer"
        },
        "feasibility": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "selected": {
          "type": "boolean"
        },
        "combinedWith": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DTInsight": {
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
