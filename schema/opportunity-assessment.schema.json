{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grokify/prism-roadmap/schema/opportunity-assessment.schema.json",
  "$ref": "#/$defs/OpportunityAssessment",
  "$defs": {
    "AssessmentCycle": {
      "properties": {
        "number": {
          "type": "integer"
        },
        "assessedAt": {
          "type": "string",
          "format": "date-time"
        },
        "supersedesId": {
          "type": "string"
        },
        "current": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CapabilityRef": {
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CategoryResult": {
      "properties": {
        "category": {
          "type": "string"
        },
        "score": {
          "type": "string"
        },
        "intScore": {
          "type": "integer"
        },
        "numericScore": {
          "type": "number"
        },
        "confidence": {
          "type": "number"
        },
        "severity": {
          "type": "string"
        },
        "reasonCodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reasoning": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "checklistResults": {
          "$ref": "#/$defs/ChecklistResults"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CategorySelection": {
      "properties": {
        "optionId": {
          "type": "string"
        },
        "resolved": {
          "type": "boolean"
        },
        "ambiguous": {
          "type": "boolean"
        },
        "ambiguousOptionIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ChecklistResults": {
      "properties": {
        "requiredPresent": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requiredMissing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "optionalPresent": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "optionalMissing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Claim": {
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "category": {
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/Validation"
        },
        "statistical": {
          "$ref": "#/$defs/StatisticalDetail"
        },
        "verdict": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "relatedClaimIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CompassAssessment": {
      "properties": {
        "profileId": {
          "type": "string"
        },
        "evidenceJson": true,
        "normalized": {
          "$ref": "#/$defs/Normalized"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/CategoryResult"
          },
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "type": "array"
        },
        "needsHumanReview": {
          "type": "boolean"
        },
        "humanReview": {
          "$ref": "#/$defs/CompassHumanReview"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CompassHumanReview": {
      "properties": {
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DerivedValidation": {
      "properties": {
        "sourceClaimIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "derivationMethod": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DimensionAnswer": {
      "properties": {
        "optionId": {
          "type": "string"
        },
        "questionId": {
          "type": "string"
        },
        "answer": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DimensionAssignment": {
      "properties": {
        "dimensionId": {
          "type": "string"
        },
        "dimensionVersion": {
          "type": "string"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/DimensionAnswer"
          },
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/CategorySelection"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EffortComponent": {
      "properties": {
        "name": {
          "type": "string"
        },
        "personDays": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EffortEstimate": {
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/EffortComponent"
          },
          "type": "array"
        },
        "low": {
          "type": "number"
        },
        "expected": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "gate": {
          "$ref": "#/$defs/EstimabilityGate"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EstimabilityGate": {
      "properties": {
        "scopeDefined": {
          "type": "boolean"
        },
        "implementationIdentified": {
          "type": "boolean"
        },
        "dependenciesIdentified": {
          "type": "boolean"
        },
        "testingIdentified": {
          "type": "boolean"
        },
        "deploymentIdentified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ExternalValidation": {
      "properties": {
        "url": {
          "type": "string"
        },
        "sourceType": {
          "type": "string"
        },
        "sourceRole": {
          "type": "string"
        },
        "reliability": {
          "type": "string"
        },
        "accessedAt": {
          "type": "string",
          "format": "date-time"
        },
        "archived": {
          "type": "boolean"
        },
        "archiveUrl": {
          "type": "string"
        },
        "quotedText": {
          "type": "string"
        },
        "verifiedMatch": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "InternalValidation": {
      "properties": {
        "method": {
          "type": "string"
        },
        "evidencePath": {
          "type": "string"
        },
        "evidenceHash": {
          "type": "string"
        },
        "reproducible": {
          "type": "boolean"
        },
        "reproductionSteps": {
          "type": "string"
        },
        "validatedBy": {
          "type": "string"
        },
        "validatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "environment": {
          "$ref": "#/$defs/ValidationEnvironment"
        },
        "output": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "JudgeMetadata": {
      "properties": {
        "judge_id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_provider": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "prompt_template": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        },
        "check_id": {
          "type": "string"
        },
        "check_version": {
          "type": "string"
        },
        "reviewer_id": {
          "type": "string"
        },
        "reviewer_name": {
          "type": "string"
        },
        "rubric_id": {
          "type": "string"
        },
        "rubric_version": {
          "type": "string"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency": {
          "type": "integer"
        },
        "tokens_used": {
          "$ref": "#/$defs/TokenUsage"
        },
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Location": {
      "properties": {
        "section": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "startOffset": {
          "type": "integer"
        },
        "endOffset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Normalized": {
      "properties": {
        "profileId": {
          "type": "string"
        },
        "reach": {
          "type": "number"
        },
        "reachBand": {
          "type": "string"
        },
        "impact": {
          "type": "number"
        },
        "confidence": {
          "type": "number"
        },
        "effortPd": {
          "type": "number"
        },
        "method": {
          "type": "string"
        },
        "inputs": true
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OKRContribution": {
      "properties": {
        "objectiveId": {
          "type": "string"
        },
        "keyResultId": {
          "type": "string"
        },
        "strength": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OpportunityAssessment": {
      "properties": {
        "id": {
          "type": "string"
        },
        "opportunity": {
          "$ref": "#/$defs/OpportunityRef"
        },
        "title": {
          "type": "string"
        },
        "judge": {
          "$ref": "#/$defs/JudgeMetadata"
        },
        "cycle": {
          "$ref": "#/$defs/AssessmentCycle"
        },
        "moscowAnswers": {
          "items": {
            "$ref": "#/$defs/ThresholdAnswer"
          },
          "type": "array"
        },
        "rice": {
          "$ref": "#/$defs/RICEAssessment"
        },
        "compass": {
          "$ref": "#/$defs/CompassAssessment"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/DimensionAssignment"
          },
          "type": "array"
        },
        "contributions": {
          "items": {
            "$ref": "#/$defs/OKRContribution"
          },
          "type": "array"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityRef"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OpportunityRef": {
      "properties": {
        "specId": {
          "type": "string"
        },
        "rmiId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RICEAssessment": {
      "properties": {
        "reach": {
          "$ref": "#/$defs/Reach"
        },
        "impactAnswers": {
          "items": {
            "$ref": "#/$defs/ThresholdAnswer"
          },
          "type": "array"
        },
        "confidenceAnswers": {
          "items": {
            "$ref": "#/$defs/ThresholdAnswer"
          },
          "type": "array"
        },
        "confidenceInsufficientEvidence": {
          "type": "boolean"
        },
        "effort": {
          "$ref": "#/$defs/EffortEstimate"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Reach": {
      "properties": {
        "fraction": {
          "type": "number"
        },
        "population": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "StatisticalDetail": {
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "asOfDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SubjectiveValidation": {
      "properties": {
        "acknowledged": {
          "type": "boolean"
        },
        "methodology": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ThresholdAnswer": {
      "properties": {
        "levelId": {
          "type": "string"
        },
        "satisfied": {
          "type": "boolean"
        },
        "criterionMet": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "TokenUsage": {
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "total_tokens": {
          "type": "integer"
        },
        "cache_read_tokens": {
          "type": "integer"
        },
        "cache_write_tokens": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Validation": {
      "properties": {
        "type": {
          "type": "string"
        },
        "external": {
          "$ref": "#/$defs/ExternalValidation"
        },
        "internal": {
          "$ref": "#/$defs/InternalValidation"
        },
        "derived": {
          "$ref": "#/$defs/DerivedValidation"
        },
        "subjective": {
          "$ref": "#/$defs/SubjectiveValidation"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ValidationEnvironment": {
      "properties": {
        "product": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "configuration": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Opportunity Assessment",
  "description": "Schema for evidence-backed opportunity assessments: MoSCoW/RICE prioritization, portfolio dimensions, OKR contributions, and capability references"
}