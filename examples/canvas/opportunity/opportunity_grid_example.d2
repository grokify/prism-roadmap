# Opportunity Canvas (Grid): Mobile App Opportunity

grid-rows: 4
grid-columns: 3

users: {
  label: "Users & Customers\nWho has the problem"
  style.fill: "#E3F2FD"
  user_manager: "Team Managers"
  user_exec: "Executives"
}

problems: {
  label: "Problems\nPains to address"
  style.fill: "#FFEBEE"
  prob_desktop_only: "Users can only access the platform fr..."
  prob_real_time: "Users miss time-sensitive notifications"
}

solutionIdeas: {
  label: "Solution Ideas\nWays to solve it"
  style.fill: "#E8F5E9"
  si1: "Native iOS and Android apps"
  si2: "Progressive Web App (PWA)"
  si3: "Mobile-optimized web experience"
}

currentSolutions: {
  label: "Solutions Today\nCurrent workarounds"
  style.fill: "#FFF3E0"
  curr_email: "Email notifications"
  curr_responsive: "Responsive web"
}

userValue: {
  label: "User Value\nBenefit to users"
  style.fill: "#E8F5E9"
  uv1: "Access critical data anywhere"
  uv2: "Respond to requests 10x faster"
  uv3: "Never miss important updates"
}

adoptionStrategy: {
  label: "Adoption Strategy\nHow they'll find it"
  style.fill: "#F3E5F5"
  as1: "In-app prompts to download mobile app"
  as2: "QR code in web dashboard"
  as3: "Email campaign to existing users"
}

userMetrics: {
  label: "User Metrics\nBehaviour to track"
  style.fill: "#E3F2FD"
  um1: "Mobile app downloads"
  um2: "Daily active mobile users"
  um3: "Time to complete key actions"
}

businessProblem: {
  label: "Business Problem\nWhy it matters to us"
  style.fill: "#FFEBEE"
  bp: "Losing customers to mobile-first competitors; 4..."
}

businessMetrics: {
  label: "Business Metrics\nOutcome to measure"
  style.fill: "#E8F5E9"
  bm1: "Mobile DAU/MAU ratio"
  bm2: "Customer retention rate"
  bm3: "Mobile-driven revenue"
}

budget: {
  grid-column-span: 3
  label: "Budget\nWhat you're willing to invest to learn whether this is worth building"
  style.fill: "#FFFDE7"
  details: "Time: 6 months | Team: 4 engineers, 1 designer, 1 PM | Cost: \$800K | Constraints: Must use existing backend APIs"
}
