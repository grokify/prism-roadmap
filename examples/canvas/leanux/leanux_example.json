        "validated": true,
        "evidence": "A/B test showed 18% improvement",
        "solutionRef": "sol-guest"
      },
      {
        "id": "hyp-shipping",
        "weBelieve": "Showing shipping costs on cart page",
        "willResultIn": "Fewer abandonments at payment step",
        "weWillKnow": "Drop-off rate at payment step decreases by 15%",
        "validated": null,
        "solutionRef": "sol-shipping"
      },
      {
        "id": "hyp-progress",
        "weBelieve": "Adding progress indicator with time estimate",
        "willResultIn": "Increased completion rate",
