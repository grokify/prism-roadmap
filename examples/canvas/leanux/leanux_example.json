      },
      {
        "id": "sol-progress",
        "description": "Progress indicator with time estimate",
        "type": "feature",
        "effort": "small",
        "confidence": "high",
        "outcomes": ["uo-speed"]
      },
      {
        "id": "sol-shipping",
        "description": "Upfront shipping calculator",
        "type": "feature",
        "effort": "medium",
        "confidence": "high",
        "outcomes": ["uo-transparency"]
      },
      {
        "id": "sol-express",
        "description": "Express checkout for returning users",
        "type": "feature",
        "effort": "large",
        "confidence": "medium",
        "outcomes": ["uo-speed"]
      }
    ],
    "hypotheses": [
      {
        "id": "hyp-guest",
        "weBelieve": "Offering prominent guest checkout option",
        "willResultIn": "20% reduction in checkout abandonment",
