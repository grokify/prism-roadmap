    "businessProblem": "Cart abandonment rate is 72%, significantly above industry average of 55%",
    "businessOutcomes": [
      {
        "id": "bo-conversion",
        "description": "Reduce cart abandonment to 55%",
        "metric": "Cart abandonment rate",
        "baseline": "72%",
        "target": "55%",
        "timeframe": "Q3 2024"
      },
      {
        "id": "bo-revenue",
        "description": "Increase checkout revenue by 20%",
        "metric": "Revenue from completed checkouts",
        "baseline": "$2M/month",
        "target": "$2.4M/month"
      }
    ],
    "users": [
      {
        "id": "user-shopper",
        "name": "Casual Shoppers",
        "description": "Browse and compare before purchasing",
        "behaviors": ["Multiple sessions before purchase", "Price sensitive", "Compare across sites"],
        "needsGoals": ["Easy comparison", "Clear pricing", "Quick checkout"],
        "currentJourney": "Often abandon at shipping cost reveal"
      },
      {
        "id": "user-returner",
        "name": "Returning Customers",
        "description": "Know what they want, expect fast checkout",
