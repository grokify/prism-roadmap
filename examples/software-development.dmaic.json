{
  "$schema": "../schema/dmaic.schema.json",
  "metadata": {
    "id": "DMAIC-SDEV-2025-001",
    "name": "Software Development Quality Metrics",
    "description": "DMAIC metrics framework for software development process improvement",
    "owner": "Alex Thompson",
    "team": "Engineering",
    "period": "FY2025-Q1",
    "version": "1.0.0",
    "status": "Active",
    "reviewCadence": "Bi-weekly"
  },
  "categories": [
    {
      "id": "code-quality",
      "name": "Code Quality",
      "description": "Metrics tracking code quality, technical debt, and maintainability",
      "order": 1,
      "owner": "Emily Zhang",
      "metrics": [
        {
          "id": "cq-001",
          "name": "Code Coverage",
          "description": "Percentage of codebase covered by automated tests",
          "order": 1,
          "baseline": 45.0,
          "current": 78.0,
          "target": 85.0,
          "unit": "%",
          "phase": "Improve",
          "trendDirection": "higher_better",
          "thresholds": {
            "warning": 70.0,
            "critical": 60.0
          },
          "frequency": "Daily",
          "dataSource": "SonarQube",
          "owner": "Emily Zhang",
          "status": "Green"
        },
        {
          "id": "cq-002",
          "name": "Technical Debt Ratio",
          "description": "Ratio of remediation cost to development cost",
          "order": 2,
          "baseline": 18.0,
          "current": 8.5,
          "target": 5.0,
          "unit": "%",
          "phase": "Improve",
          "trendDirection": "lower_better",
          "thresholds": {
            "warning": 10.0,
            "critical": 15.0
          },
          "frequency": "Weekly",
          "dataSource": "SonarQube",
          "owner": "Emily Zhang",
          "status": "Yellow"
        },
        {
          "id": "cq-003",
          "name": "Code Review Coverage",
          "description": "Percentage of pull requests receiving thorough code review",
          "order": 3,
          "baseline": 70.0,
          "current": 95.0,
          "target": 100.0,
          "unit": "%",
          "phase": "Control",
          "trendDirection": "higher_better",
          "controlLimits": {
            "ucl": 100.0,
            "lcl": 90.0,
            "centerLine": 95.0,
            "sigma": 2.0
          },
          "thresholds": {
            "warning": 90.0,
            "critical": 80.0
          },
          "frequency": "Daily",
          "dataSource": "GitHub",
          "owner": "Emily Zhang",
          "status": "Green"
        }
      ]
    },
    {
      "id": "delivery",
      "name": "Delivery Performance",
      "description": "Metrics tracking deployment frequency, lead time, and reliability",
      "order": 2,
      "owner": "Michael Park",
      "metrics": [
        {
          "id": "del-001",
          "name": "Deployment Frequency",
          "description": "Number of production deployments per week",
          "order": 1,
          "baseline": 2,
          "current": 12,
          "target": 20,
          "unit": "deploys/week",
          "phase": "Improve",
          "trendDirection": "higher_better",
          "thresholds": {
            "warning": 8,
            "critical": 4
          },
          "frequency": "Weekly",
          "dataSource": "CI/CD Platform",
          "owner": "Michael Park",
          "status": "Green"
        },
        {
          "id": "del-002",
          "name": "Lead Time for Changes",
          "description": "Time from code commit to production deployment",
          "order": 2,
          "baseline": 336,
          "current": 24,
          "target": 8,
          "unit": "hours",
          "phase": "Improve",
          "trendDirection": "lower_better",
          "thresholds": {
            "warning": 48,
            "critical": 168
          },
          "frequency": "Weekly",
          "dataSource": "CI/CD Platform",
          "owner": "Michael Park",
          "status": "Green"
        },
        {
          "id": "del-003",
          "name": "Change Failure Rate",
          "description": "Percentage of deployments causing production incidents",
          "order": 3,
          "baseline": 25.0,
          "current": 8.0,
          "target": 5.0,
          "unit": "%",
          "phase": "Control",
          "trendDirection": "lower_better",
          "controlLimits": {
            "ucl": 10.0,
            "lcl": 0.0,
            "centerLine": 5.0,
            "sigma": 2.0
          },
          "thresholds": {
            "warning": 10.0,
            "critical": 15.0
          },
          "frequency": "Weekly",
          "dataSource": "Incident Management",
          "owner": "Michael Park",
          "status": "Yellow"
        }
      ]
    },
    {
