{
  "$schema": "../schema/bsc.schema.json",
  "metadata": {
    "id": "bookkeeping-fy2027",
    "name": "Bookkeeping App Balanced Scorecard FY2027",
    "author": "Strategy Office",
    "team": "Bookkeeping App",
    "period": "FY2027",
    "version": "1.0",
    "status": "Active"
  },
  "mission": "Give small business owners books they can trust without becoming bookkeepers",
  "vision": "The bookkeeping app small businesses keep using",
  "strategy": "Win on retention, not acquisition: get each new account to a reconciled month fast, keep bank data flowing without help, and answer questions before they become tickets.",
  "perspectives": [
    { "id": "financial", "name": "Financial", "kind": "financial",
      "question": "To succeed financially, how should we appear to those who fund us?" },
    { "id": "customer", "name": "Customer", "kind": "customer",
      "question": "To achieve our vision, how should we appear to our customers?" },
    { "id": "internal-process", "name": "Internal Process", "kind": "internal_process",
      "question": "To satisfy our customers, which processes must we excel at?" },
    { "id": "learning-growth", "name": "Learning and Growth", "kind": "learning_growth",
      "question": "To excel at those processes, how will we sustain our ability to change and improve?" }
  ],
  "themes": [
    { "id": "theme-retention", "name": "Retention", "owner": "Head of Product",
      "description": "Accounts that reach a reconciled month early stay." },
    { "id": "theme-efficiency", "name": "Efficiency", "owner": "Head of Operations",
      "description": "Reliable data and self-service lower the cost to serve an account." }
  ],
  "objectives": [
    { "id": "fin-recurring-revenue", "name": "Grow recurring revenue", "perspectiveId": "financial",
      "themeIds": ["theme-retention"], "owner": "Chief Financial Officer", "priority": "P0" },
    { "id": "fin-cost-to-serve", "name": "Lower the cost to serve an account", "perspectiveId": "financial",
      "themeIds": ["theme-efficiency"], "owner": "Chief Financial Officer", "priority": "P1" },
    { "id": "cus-retention", "name": "Keep small businesses using the app", "perspectiveId": "customer",
      "themeIds": ["theme-retention"], "owner": "Head of Product", "priority": "P0",
      "contributesTo": ["fin-recurring-revenue"] },
    { "id": "cus-time-saved", "name": "Save owners time on their books", "perspectiveId": "customer",
      "themeIds": ["theme-efficiency"], "owner": "Head of Product", "priority": "P1",
      "contributesTo": ["cus-retention"] },
    { "id": "ip-onboarding", "name": "Get every new account to a reconciled month in its first week",
      "perspectiveId": "internal-process", "themeIds": ["theme-retention"], "owner": "Head of Onboarding",
      "priority": "P0", "contributesTo": ["cus-retention"] },
    { "id": "ip-bank-sync", "name": "Make bank sync reliable", "perspectiveId": "internal-process",
      "themeIds": ["theme-efficiency"], "owner": "Head of Platform", "priority": "P0",
      "contributesTo": ["cus-time-saved", "fin-cost-to-serve"] },
    { "id": "ip-self-serve", "name": "Answer questions inside the app", "perspectiveId": "internal-process",
      "themeIds": ["theme-efficiency"], "owner": "Head of Support", "priority": "P1",
      "contributesTo": ["cus-time-saved", "fin-cost-to-serve"] },
    { "id": "lg-data-skills", "name": "Build the team's skills in bank data integrations",
      "perspectiveId": "learning-growth", "themeIds": ["theme-efficiency"], "owner": "Head of Engineering",
      "priority": "P2", "contributesTo": ["ip-bank-sync"] },
    { "id": "lg-feedback-loop", "name": "Put customer feedback in front of every squad",
      "perspectiveId": "learning-growth", "themeIds": ["theme-retention"], "owner": "Head of Research",
      "priority": "P2", "contributesTo": ["ip-onboarding", "ip-self-serve"] }
  ],
  "measures": [
    { "id": "m-arr", "name": "Annual recurring revenue", "objectiveId": "fin-recurring-revenue", "type": "lag",
      "owner": "Chief Financial Officer", "baseline": "4.2", "target": "6.0", "current": "4.6", "unit": "million USD",
      "direction": "increase", "dueDate": "2027-12-31", "frequency": "Monthly", "source": "Billing system",
      "progress": 0.22, "status": "On Track" },
    { "id": "m-cost-per-account", "name": "Support and hosting cost per active account per month",
      "objectiveId": "fin-cost-to-serve", "type": "lag", "owner": "Head of Operations",
      "baseline": "3.10", "target": "2.40", "current": "2.95", "unit": "USD", "direction": "decrease",
      "dueDate": "2027-12-31", "frequency": "Quarterly", "source": "Finance cost model",
      "progress": 0.21, "status": "At Risk" },
    { "id": "m-retention-90", "name": "Accounts still active at 90 days", "objectiveId": "cus-retention",
      "type": "lag", "owner": "Head of Product", "baseline": "52", "target": "65", "current": "56", "unit": "%",
      "direction": "increase", "dueDate": "2027-12-31", "frequency": "Monthly", "source": "Product analytics",
      "thresholds": { "green": "63", "red": "55" }, "progress": 0.31, "status": "On Track" },
    { "id": "m-close-hours", "name": "Hours an owner spends closing a month", "objectiveId": "cus-time-saved",
      "type": "lag", "owner": "Head of Product", "baseline": "6", "target": "2", "current": "5", "unit": "hours",
      "direction": "decrease", "dueDate": "2027-12-31", "frequency": "Quarterly", "source": "Owner survey",
      "progress": 0.25, "status": "On Track" },
    { "id": "m-first-week-reconciled", "name": "New accounts with a reconciled month in their first week",
      "objectiveId": "ip-onboarding", "type": "lead", "owner": "Head of Onboarding",
      "baseline": "18", "target": "40", "current": "24", "unit": "%", "direction": "increase",
      "dueDate": "2027-12-31", "frequency": "Weekly", "source": "Product analytics",
      "thresholds": { "green": "35", "red": "20" }, "progress": 0.27, "status": "On Track" },
    { "id": "m-sync-success", "name": "Bank syncs that complete without help", "objectiveId": "ip-bank-sync",
      "type": "lead", "owner": "Head of Platform", "baseline": "93", "target": "99", "current": "94", "unit": "%",
      "direction": "increase", "dueDate": "2027-12-31", "frequency": "Weekly", "source": "Sync service logs",
      "progress": 0.17, "status": "Behind" },
    { "id": "m-self-serve", "name": "Questions answered in the app without a ticket", "objectiveId": "ip-self-serve",
      "type": "lead", "owner": "Head of Support", "baseline": "30", "target": "55", "current": "36", "unit": "%",
      "direction": "increase", "dueDate": "2027-12-31", "frequency": "Monthly", "source": "Help center analytics",
      "progress": 0.24, "status": "On Track" },
    { "id": "m-certified-engineers", "name": "Engineers certified on the bank data platform",
      "objectiveId": "lg-data-skills", "type": "lead", "owner": "Head of Engineering",
      "baseline": "4", "target": "12", "current": "6", "unit": "engineers", "direction": "increase",
      "dueDate": "2027-12-31", "frequency": "Quarterly", "source": "Training records",
      "progress": 0.25, "status": "On Track" },
    { "id": "m-feedback-squads", "name": "Squads that review customer feedback every sprint",
      "objectiveId": "lg-feedback-loop", "type": "lead", "owner": "Head of Research",
      "baseline": "2", "target": "6", "current": "3", "unit": "squads", "direction": "increase",
      "dueDate": "2027-12-31", "frequency": "Monthly", "source": "Sprint review notes",
      "progress": 0.25, "status": "On Track" }
  ],
  "initiatives": [
    { "id": "init-guided-import", "name": "Ship guided bank import", "objectiveIds": ["ip-onboarding", "cus-retention"],
      "owner": "Onboarding squad", "startDate": "2027-01-04", "endDate": "2027-03-26", "budget": "2 engineers for a quarter",
      "status": "In Progress" },
    { "id": "init-sync-rebuild", "name": "Rebuild the bank sync pipeline",
      "objectiveIds": ["ip-bank-sync", "cus-time-saved", "fin-cost-to-serve"], "owner": "Platform squad",
      "startDate": "2027-02-01", "endDate": "2027-09-30", "budget": "4 engineers for three quarters",
      "status": "In Progress", "dependencies": ["init-integration-academy"] },
    { "id": "init-help-center", "name": "Put answers to the top 50 questions inside the app",
      "objectiveIds": ["ip-self-serve", "fin-cost-to-serve"], "owner": "Support Operations",
      "startDate": "2027-03-01", "endDate": "2027-06-30", "status": "Planned" },
    { "id": "init-integration-academy", "name": "Run a bank data integration academy", "objectiveIds": ["lg-data-skills"],
      "owner": "Engineering Enablement", "startDate": "2027-01-11", "endDate": "2027-04-30", "status": "In Progress" },
    { "id": "init-feedback-rotation", "name": "Rotate each squad through customer calls", "objectiveIds": ["lg-feedback-loop"],
      "owner": "Research team", "startDate": "2027-01-04", "status": "In Progress" },
    { "id": "init-annual-plans", "name": "Offer annual plans", "objectiveIds": ["fin-recurring-revenue"],
      "owner": "Growth team", "startDate": "2027-04-01", "endDate": "2027-05-31", "status": "Planned" }
  ]
